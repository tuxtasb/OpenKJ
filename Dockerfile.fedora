FROM fedora:latest

RUN dnf upgrade -y && \
	dnf install -y \
	gcc-c++ \
	cmake \
	ninja-build \
	pkgconf-pkg-config \
	git \
	qt6-qtbase-devel \
	qt6-qtsvg-devel \
	gstreamer1-devel \
	gstreamer1-plugins-base-devel \
	spdlog-devel \
	taglib-devel \
	&& \
	dnf clean all

COPY ./ /openkj/
WORKDIR /openkj/
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
RUN cmake --build build
